# Copiar este archivo como .env y completar los valores. .env no se versiona.
# Solo desarrollo local: nunca usar credenciales de producción.

# Conexión a PostgreSQL local.
# Si la contraseña tiene caracteres especiales (@ : / # ? %), codificarlos en la URL (p. ej. @ -> %40).
DATABASE_URL=postgres://grupo_cave:CAMBIAR_CONTRASENA@localhost:5432/grupo_cave_v1

# Esquema de la aplicación
DATABASE_SCHEMA=erp

# Esquema aislado para pruebas automatizadas (misma base de datos)
TEST_DATABASE_SCHEMA=erp_test

# Extracción de TDR con IA (subfase 1.3). Proveedor y modelo se eligen aquí; cada intento
# registra cuáles se usaron. Antes de usar un proveedor hay que instalar su SDK oficial y
# registrar su adaptador (ver MEMORY.md). Reiniciar el servidor tras cambiar estos valores.
# AI_PROVIDER: anthropic | openai | google
# AI_PROVIDER=
# AI_MODEL: identificador exacto del modelo, tal como lo publica el proveedor.
# AI_MODEL=
# Clave solo del proveedor elegido (nunca claves de producción):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# Opcionales: tiempo máximo por documento (ms, 10 min por defecto), reintentos ante fallos
# transitorios (2) y procesamientos simultáneos (2).
# AI_TIMEOUT_MS=600000
# AI_MAX_RETRIES=2
# AI_MAX_CONCURRENCY=2

# Almacenamiento privado de los PDF (subfase 1.2). Opcionales: sin valor se usa storage/
# en la raíz del proyecto (excluida de Git) y un máximo de 50 MB por archivo.
# STORAGE_LOCAL_DIR=storage
# TDR_MAX_BYTES=52428800
# Máximo por fotografía de evidencia (Ejecución): 15 MB si no se indica.
# EVIDENCE_MAX_BYTES=15728640

# Inicio de sesión. «dev» (por omisión): «Entrar como…» sin contraseña; solo funciona con la
# base de datos local, desde 127.0.0.1 y fuera de un hosting. «supabase» llegará con la parte S
# del plan y hoy se rechaza.
# AUTH_PROVIDER=dev
