# Dependencias
node_modules/
.pnpm-store/

# Variables de entorno y secretos (solo se versiona .env.example)
.env
.env.*
!.env.example

# Almacenamiento local privado de archivos (PDF de TDR, evidencias). Solo la carpeta de la
# raíz: el código del adaptador vive en apps/web/src/integrations/storage/ y sí se versiona.
/storage/

# Datos locales de demostración (nombres y montos del prototipo; decisión E-D5 de PLAN.md)
/apps/web/scripts/local/

# Volcados y respaldos de base de datos
*.dump
*.backup
*.sql.gz
dumps/

# Compilación y caché
dist/
build/
.next/
coverage/
*.tsbuildinfo

# Registros
*.log
npm-debug.log*
pnpm-debug.log*

# Sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Local Netlify folder
.netlify
