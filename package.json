{
  "name": "erp-v1",
  "private": true,
  "description": "Grupo Cave V1 — ERP de proyectos (Fase 1: Operación › Requerimiento)",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "db:check": "pnpm --filter @erp/db run db:check",
    "db:migrate": "pnpm --filter @erp/db run db:migrate",
    "db:migrate:test": "pnpm --filter @erp/db run db:migrate:test",
    "db:status": "pnpm --filter @erp/db run db:status",
    "db:seed:demo": "pnpm --filter web run db:seed:demo",
    "db:convert:paid": "pnpm --filter web run db:convert:paid",
    "db:import:matrix": "pnpm --filter web run db:import:matrix",
    "db:users:example": "pnpm --filter @erp/db run db:users:example",
    "test:db": "pnpm --filter @erp/db run test",
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "test": "pnpm -r run test"
  }
}
